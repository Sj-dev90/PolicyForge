[
  {
    "id": "rule_refund_standard_window",
    "name": "Standard 30-day refund window",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "all": [
        {"field": "days_since_delivery", "op": "LTE", "value": 30},
        {"field": "item_delivered", "op": "IS_TRUE", "value": true},
        {"field": "is_final_sale", "op": "IS_FALSE", "value": false}
      ]
    },
    "effect": "ALLOW",
    "priority": 0,
    "overrides": [],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "Customers may request a refund within 30 days of delivery for non-final sale items."
    }
  },
  {
    "id": "rule_refund_past_deadline",
    "name": "Refunds denied after 30 days",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "field": "days_since_delivery",
      "op": "GT",
      "value": 30
    },
    "effect": "DENY",
    "priority": 0,
    "overrides": [],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "Refund requests submitted more than 30 days after delivery are strictly denied."
    }
  },
  {
    "id": "rule_refund_after_replacement_cancelled",
    "name": "Refund eligibility upon cancelled replacement",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "field": "replacement_cancelled",
      "op": "IS_TRUE",
      "value": true
    },
    "effect": "ALLOW",
    "priority": 0,
    "overrides": [],
    "state_updates": {
      "refund_eligibility_restored": true
    },
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "If a replacement order is cancelled, the customer may request a refund."
    }
  },
  {
    "id": "rule_refund_final_sale_deny",
    "name": "Final sale items ineligible for refund",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "field": "is_final_sale",
      "op": "IS_TRUE",
      "value": true
    },
    "effect": "DENY",
    "priority": 10,
    "overrides": ["rule_refund_standard_window"],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "Final sale items are not eligible for refunds under any circumstances."
    }
  },
  {
    "id": "rule_refund_before_delivery_deny",
    "name": "Refund denied before delivery",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "field": "item_delivered",
      "op": "IS_FALSE",
      "value": false
    },
    "effect": "DENY",
    "priority": 5,
    "overrides": [],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "Refunds cannot be processed before an item is delivered; cancel the order instead."
    }
  },
  {
    "id": "rule_refund_vip_extended_window",
    "name": "VIP 60-day refund window",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "all": [
        {"field": "customer_tier", "op": "EQ", "value": "VIP"},
        {"field": "days_since_delivery", "op": "LTE", "value": 60},
        {"field": "item_delivered", "op": "IS_TRUE", "value": true}
      ]
    },
    "effect": "ALLOW",
    "priority": 2,
    "overrides": ["rule_refund_past_deadline"],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "VIP members enjoy an extended 60-day refund window."
    }
  },
  {
    "id": "rule_refund_opened_item_deny",
    "name": "Opened non-defective items denied after 14 days",
    "decision": "REFUND",
    "trigger": "REFUND_REQUESTED",
    "when": {
      "all": [
        {"field": "item_opened", "op": "IS_TRUE", "value": true},
        {"field": "customer_tier", "op": "EQ", "value": "STANDARD"},
        {"field": "item_damaged", "op": "IS_FALSE", "value": false},
        {"field": "days_since_delivery", "op": "GT", "value": 14}
      ]
    },
    "effect": "DENY",
    "priority": 1,
    "overrides": [],
    "state_updates": null,
    "source": {
      "doc_name": "NovaCart Returns Policy v1.0",
      "verbatim_sentence": "Standard customers cannot return opened non-damaged items after 14 days."
    }
  },
  {
